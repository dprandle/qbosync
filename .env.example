MONGODB_URI=your_mongodb_connection_string_here
MONGODB_DB_NAME=your_database_name_here

# sandbox (dev: Intuit app development keys + a sandbox company) or production.
QBO_ENV=sandbox
QBO_CLIENT_ID=
QBO_CLIENT_SECRET=
# Must match a redirect URI registered on the Intuit app - the public zetrick-api
# callback, which forwards to this service's loopback API server.
QBO_REDIRECT_URI=https://api.zetrick.com/quickbooks/callback
# Optional but recommended: the only company (realm) this deployment may connect to.
QBO_EXPECTED_REALM_ID=
QBO_TOKEN_FILE=./qbo_tokens.json
QBO_MINOR_VERSION=75
QBO_RATE_LIMIT_MAX_REQUESTS=400
QBO_RATE_LIMIT_WINDOW_MS=60000

# Secret key for the HMAC of each vendor's synced fields (stored in qbo_object_map).
# Generate with: openssl rand -hex 32. Changing it re-pushes every vendor once.
SYNC_HASH_KEY=

SYNC_INTERVAL_MS=60000
API_SERVER_PORT=3002

# Cleanup pass window, server-local time. DAY: 0=Sunday..6=Saturday, -1 = daily.
MAPPING_CLEANUP_DAY=-1
MAPPING_CLEANUP_START_HOUR=8
MAPPING_CLEANUP_WINDOW_HOURS=1

# Alerts (floored cursors, permanent per-feature failures, lost QBO connection).
# Disabled unless both SENDGRID_API_KEY and ALERT_EMAIL_TO are set.
SENDGRID_API_KEY="Bearer token"
ALERT_EMAIL_TO=
ALERT_EMAIL_FROM=no-reply@zetrick.com
CURSOR_FLOOR_ALERT_PASSES=10
CURSOR_FLOOR_REALERT_HOURS=24
